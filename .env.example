# Copy to .env in Guardian's project root. Never place keys in scanned repositories.
# Use distinct labels only for keys from independently provisioned Google projects.
GEMINI_API_KEY_1=
GEMINI_KEY_1_PROJECT=a
GEMINI_API_KEY_2=
GEMINI_KEY_2_PROJECT=b
GEMINI_API_KEY_3=
GEMINI_KEY_3_PROJECT=c
GEMINI_API_KEY_4=
GEMINI_KEY_4_PROJECT=d

# Generation access and current model availability must be verified on demand.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite
AI_ENABLED=true
AI_LOCAL_ENABLED=false
AI_MAX_CALLS_PER_SCAN=3
AI_MAX_DAILY_REQUESTS=30
AI_CACHE_ENABLED=true
AI_MIN_REQUEST_INTERVAL_SECONDS=12
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
